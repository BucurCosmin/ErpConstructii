<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Importatorul ISDP (D-50): citește .xls (BIFF, ce exportă ISDP) și .xlsx în FoaieCalcul (CititorExcel) și le convertește în modelul canonic (ConversieIsdp, ImportatorIsdp).
    ExcelDataReader (licență MIT) citește ambele formate, fără Excel instalat.
    Versiunea pachetului: în Directory.Packages.props.
  -->
  <ItemGroup>
    <PackageReference Include="ExcelDataReader" />
  </ItemGroup>
  <ItemGroup>
    <!-- Înregistrarea în DI (AdaugaImportatorIsdp), ca la ceilalți importatori. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ErpConstructii.Devize.Import.Isdp\ErpConstructii.Devize.Import.Isdp.csproj" />
    <!-- Importatorul (ImportatorIsdp, ConversieIsdp) produce modelul canonic al modulului Devize. -->
    <ProjectReference Include="..\ErpConstructii.Devize\ErpConstructii.Devize.csproj" />
  </ItemGroup>
</Project>
