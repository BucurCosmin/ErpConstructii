<Project>
  <!--
    Gestionare centralizată a versiunilor de pachete (Central Package Management).
    În .csproj se scrie doar <PackageReference Include="..." /> fără versiune.

    Versiuni verificate cu nuget.org la 2026-11-03 (ultimele stabile compatibile cu .NET 10).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Persistență -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- Autentificare (D-07) -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
    <!-- API -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <!-- Documente -->
    <!-- OCR local pentru documente scanate (Tesseract) și randarea PDF-urilor în imagini (PDFium) -->
    <PackageVersion Include="Tesseract" Version="5.2.0" />
    <PackageVersion Include="PDFtoImage" Version="5.4.0" />
    <!-- Textul digital din PDF-uri (facturi generate de programe), fără OCR -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- Citirea exporturilor ISDP (.xls BIFF și .xlsx), fără Excel instalat; MIT. Verificat cu nuget.org la 2026-11-12. -->
    <PackageVersion Include="ExcelDataReader" Version="3.9.0" />
    <!-- PDF în formatul standard al documentelor. NU actualiza peste 6.2.x: de la 6.3 / 6.5 pachetul e AGPL-3.0 (licență incompatibilă cu D-10); 6.2.4 e MIT. -->
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- De adăugat la implementarea importatorilor (vezi CLAUDE.md):
         ClosedXML (Excel), net.sf.mpxj-for-csharp (Primavera / MS Project). -->
    <!-- Teste -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
