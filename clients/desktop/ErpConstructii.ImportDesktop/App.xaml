<Application x:Class="ErpConstructii.ImportDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:ErpConstructii.ImportDesktop.Model"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <m:DeVerificatLaFundal x:Key="DeVerificat" />
        <m:BoolLaVizibilitate x:Key="Vizibil" />
        <m:BoolLaVizibilitate x:Key="Ascuns" Invers="True" />
        <m:NulLaVizibilitate x:Key="NulAscuns" />
        <m:StareLaCuloare x:Key="CuloareStare" />
        <m:TipLaDenumire x:Key="DenumireTip" />

        <SolidColorBrush x:Key="Albastru" Color="#1F4E9C" />
        <SolidColorBrush x:Key="Fundal" Color="#F4F6F8" />
        <SolidColorBrush x:Key="Margine" Color="#D9DEE5" />

        <Style TargetType="TextBlock" x:Key="Eticheta">
            <Setter Property="Foreground" Value="#4A5568" />
            <Setter Property="Margin" Value="0,6,0,2" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Sectiune">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="BorderBrush" Value="{StaticResource Margine}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Margine}" />
        </Style>
        <Style TargetType="Button" x:Key="Principal" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Albastru}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Margine}" />
            <Setter Property="BorderBrush" Value="{StaticResource Margine}" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="MinHeight" Value="80" />
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{Binding DeVerificat, Converter={StaticResource DeVerificat}}" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
