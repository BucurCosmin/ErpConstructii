<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Teste pe exporturile ISDP reale (fixture-uri JSON în tests/samples/isdp, generate din fișierele
    primite: „extras de resurse” .xls și „F3” .xlsx pentru șanțul de investigații chilleri).
    Valorile așteptate au fost verificate independent (Python) înainte de scrierea testelor.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Devize\ErpConstructii.Devize.Import.Isdp\ErpConstructii.Devize.Import.Isdp.csproj" />
    <!-- Testul de acceptanță al modelului de deviz: devizul real ISDP pus în modelul ERP. -->
    <ProjectReference Include="..\..\src\Modules\Devize\ErpConstructii.Devize\ErpConstructii.Devize.csproj" />
    <!-- Testul de acceptanță al adaptorului Excel (fișierele originale, dacă există local). -->
    <ProjectReference Include="..\..\src\Modules\Devize\ErpConstructii.Devize.Import.Isdp.Excel\ErpConstructii.Devize.Import.Isdp.Excel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\samples\isdp\*.json" Link="samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
